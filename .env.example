# Resend (https://resend.com/api-keys) — used to send the OTP e-mail that
# confirms an address before an account is created.
# RESEND_FROM must be an address/domain verified in Resend.
RESEND_API_KEY=
RESEND_FROM=Cvis <onboarding@resend.dev>

# Random signing secret for the OTP cookie (32+ characters).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
