# Google OAuth client (Google Cloud Console → APIs & Services → Credentials →
# OAuth client ID, type "Web application"). Authorised redirect URIs:
#   http://localhost:5173/api/auth/google/callback
#   https://cvis-68070080.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (https://resend.com/api-keys) — used to send the OTP e-mail.
# RESEND_FROM must be an address/domain verified in Resend.
RESEND_API_KEY=
RESEND_FROM=Cvis <onboarding@resend.dev>

# Random signing secret for the session/OTP cookies (32+ characters).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Optional: pin the public origin used in the OAuth redirect.
# APP_ORIGIN=https://cvis-68070080.vercel.app
